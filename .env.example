# --- MSSQL connection ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=mydb
MSSQL_USER=readonly_user
MSSQL_PASSWORD=changeme
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false

# --- Safety / gating ---
# When true, only SELECT/WITH/EXPLAIN statements are allowed.
MCP_READ_ONLY=true

# One of: interactive | dual_stage | off
#  - interactive: every query prompts the user via MCP elicitation (Y/N)
#  - dual_stage:  agent calls request_query and gets a REQ-id; human runs
#                 `mcp-mssql-approve <id>` in another terminal; agent then
#                 polls get_query_result.
#  - off:         no gating (only for trusted dev environments).
MCP_HITL_MODE=interactive

# Where dual-stage pending request files live (relative to cwd).
MCP_PENDING_DIR=.mcp-pending

# Per-query timeout (ms).
MCP_QUERY_TIMEOUT_MS=30000

# Truncate result sets to this many rows.
MCP_MAX_ROWS=1000
