# ---------------------------------------------------------------------------
# mcp-mssql configuration
#
# Two layouts are supported:
#   A) ONE database  — just fill the unprefixed MSSQL_* vars below.
#   B) MANY databases — set MSSQL_CONNECTIONS=tag1,tag2 and add an
#      MSSQL_<TAG>_* block per tag. Any field a tag doesn't set falls back to
#      the unprefixed MSSQL_* value, so shared settings are written once.
#      Tag → prefix: uppercase, "-" becomes "_"   (psa-edu → MSSQL_PSA_EDU_)
# ---------------------------------------------------------------------------

# --- Shared / single-database connection -----------------------------------
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=mydb            # required in layout A; ignored as a connection in layout B
MSSQL_USER=readonly_user
MSSQL_PASSWORD=change-me
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
# MCP_SOURCE_LABEL=shop        # layout A only: tag shown to the agent (default: database name)

# --- Multiple tagged connections (layout B) --------------------------------
# MSSQL_CONNECTIONS=psa-edu,hrms
#
# MSSQL_PSA_EDU_DATABASE=PsaEdu
# MSSQL_PSA_EDU_DESCRIPTION=PSA education portal: students, courses, enrollments, fees
#
# MSSQL_HRMS_DATABASE=Hrms
# MSSQL_HRMS_DESCRIPTION=HR system: employees, departments, leave, payroll
# MSSQL_HRMS_SERVER=hr-db.internal      # per-tag override; otherwise MSSQL_SERVER is used
# MSSQL_HRMS_USER=hr_readonly
# MSSQL_HRMS_PASSWORD=change-me
# MSSQL_HRMS_SSH_ENABLED=false          # opt this tag out of the shared SSH tunnel
#
# DESCRIPTION is what the AI reads to decide which database a question belongs
# to — describe the app and the kind of data, not the server.

# --- SSH bastion tunnel (shared default; override per tag with MSSQL_<TAG>_SSH_*) ---
MSSQL_SSH_ENABLED=false
# MSSQL_SSH_HOST=bastion.example.com
# MSSQL_SSH_PORT=22
# MSSQL_SSH_USER=awais
# MSSQL_SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# MSSQL_SSH_PASSPHRASE=
# MSSQL_SSH_PASSWORD=
# MSSQL_SSH_USE_AGENT=false
# MSSQL_SSH_AGENT_SOCK=
# MSSQL_SSH_LOCAL_PORT=0               # 0 = pick a free ephemeral port

# --- Server behaviour --------------------------------------------------------
MCP_READ_ONLY=true
MCP_HITL_MODE=interactive              # interactive | dual_stage | off
MCP_PENDING_DIR=.mcp-pending
MCP_QUERY_TIMEOUT_MS=30000
MCP_APPROVAL_TIMEOUT_MS=300000
MCP_MAX_ROWS=1000
MCP_EAGER_CONNECT=true                 # false = don't open pools at startup
