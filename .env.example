# --- MSSQL connection ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=mydb
MSSQL_USER=readonly_user
MSSQL_PASSWORD=changeme
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false

# --- Optional SSH tunnel ---
# Set MSSQL_SSH_ENABLED=true to make the MCP server open an SSH port-forward to
# MSSQL_SERVER:MSSQL_PORT through a bastion host at startup. The mssql client
# then connects to 127.0.0.1:<local-port> instead. MSSQL_SERVER stays the
# private DB hostname (the value the BASTION can reach), not the bastion itself.
MSSQL_SSH_ENABLED=false
# MSSQL_SSH_HOST=bastion.example.com
# MSSQL_SSH_PORT=22
# MSSQL_SSH_USER=awais
# Pick ONE auth method:
# (1) explicit key file (recommended):
# MSSQL_SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# MSSQL_SSH_PASSPHRASE=          # only if the key is encrypted
# (2) password:
# MSSQL_SSH_PASSWORD=
# (3) ssh-agent — uses $SSH_AUTH_SOCK from your shell. Convenient if you
#     normally SSH without `-i`, since the agent holds the key already.
# MSSQL_SSH_USE_AGENT=true
# MSSQL_SSH_AGENT_SOCK=          # override $SSH_AUTH_SOCK if needed
# Local port to bind. 0 (or unset) picks a free ephemeral port automatically.
# MSSQL_SSH_LOCAL_PORT=0

# --- Safety / gating ---
# Friendly name for this database, surfaced to the agent so it can cite the
# source in its replies (e.g. "Source: mssql:abcname"). Defaults to MSSQL_DATABASE
# if unset.
# MCP_SOURCE_LABEL=abcname

# When true, only SELECT/WITH/EXPLAIN statements are allowed.
MCP_READ_ONLY=true

# One of: interactive | dual_stage | off
#  - interactive: agent calls `query`, server writes a pending request, blocks
#                 until the operator approves via the watcher terminal
#                 (`npm run approve:watch`), then runs and returns rows.
#  - dual_stage:  agent calls request_query → REQ-id, polls get_query_result.
#                 Human approves the same way (watcher / approve CLI).
#  - off:         no gating (only for trusted dev environments).
MCP_HITL_MODE=interactive

# Where pending request files live (used by both interactive and dual_stage).
MCP_PENDING_DIR=.mcp-pending

# Per-query DB timeout (ms).
MCP_QUERY_TIMEOUT_MS=30000

# How long `query` blocks waiting for the operator to approve, in ms.
# Long enough for you to actually walk over to the watcher terminal, but short
# enough that the MCP client doesn't itself time out the tool call.
MCP_APPROVAL_TIMEOUT_MS=300000

# Truncate result sets to this many rows.
MCP_MAX_ROWS=1000
